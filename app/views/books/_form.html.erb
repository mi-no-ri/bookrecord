<div class="wrap">
<h1>わたしの本棚</h1>

    <%# 新規登録画面(new)・編集画面(edit)から渡されたbookを使ってフォームを作成 %>
    <%= form_with model: book do |form| %>

        <table>
            <tr>
                <th><%= form.label :title, "タイトル" %></th>
                <td><%= form.text_field :title %></td>
            </tr>
            <tr>
                <th><%= form.label :author, "著者" %></th>
                <td><%= form.text_field :author %></td>
            </tr>
            <tr>
                <th><%= form.label :reading_status, "読書状況" %></th>
                <td><%= form.radio_button :reading_status, "finished" %>
                    <%= form.label :reading_status_finished, "読了" %>

                    <%= form.radio_button :reading_status, "reading" %>
                    <%= form.label :reading_status_reading, "読書中" %>

                    <%= form.radio_button :reading_status, "unread" %>
                    <%= form.label :reading_status_unread, "未読" %>
                </td>
            </tr>
            <tr>
                <th><%= form.label :acquisition_type, "入手方法" %></th>
                <td>
                    <%= form.radio_button :acquisition_type, "purchase" %>
                    <%= form.label :acquisition_type_purchase, "購入" %>

                    <%= form.radio_button :acquisition_type, "borrowed" %>
                    <%= form.label :acquisition_type_borrowed, "借りた" %>

                    <%= form.radio_button :acquisition_type, "not_owned" %>
                    <%= form.label :acquisition_type_not_owned, "未入手" %>
                </td>
            </tr>
            <tr>
                <th>媒体</th>
                <td>
                    <%= form.check_box :paper %>
                    <%= form.label :paper, "紙書籍" %>

                    <%= form.check_box :ebook %>
                    <%= form.label :ebook, "電子書籍" %>
                </td>
            </tr>
            <tr>
                <th>読書期間</th>
                <td>
                    <p><%= form.label :started_on, "開始日" %>
                        <%= form.date_field :started_on %>
                    </p>    
                    <p><%= form.label :finished_on, "終了日" %>
                        <%= form.date_field :finished_on %>
                    </p>
                </td>
            </tr>
            <tr>
                <th><%= form.label :memo, "メモ" %></th>
                <td><%= form.text_area :memo %></td>
            </tr>
        </table>
        <%= form.submit "登録" %>
        <%= link_to "キャンセル", books_path %>
    <% end %>
</div>