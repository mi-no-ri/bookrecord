<div class="wrap">
<h1>わたしの本棚</h1>
<%= link_to "ログアウト", logout_path, class:"button logout_button", data: { turbo_method: :delete } %>

    <table id="show_table">
        <tr>
            <th>タイトル</th>
            <td><%= @book.title %></td>
        </tr>

        <tr>
            <th>著者</th>
            <td><%= @book.author %></td>
        </tr>

        <tr>
            <th>読書状況</th>
            <%# reading_statusのenumをja.ymlから取得し、日本語で表示 %>
            <td><%= t "enums.book.reading_status.#{@book.reading_status}" %></td>
        </tr>

        <tr>
            <th>入手方法</th>
            <%# acquisition_typeのenumをja.ymlから取得し、日本語で表示 %>
            <td><%= t "enums.book.acquisition_type.#{@book.acquisition_type}" %></td>
        </tr>

        <tr>
            <th>媒体</th>
            <td>
                <%# nilを取り除き、残った文字を/で結合する %>
                <%= [("紙書籍" if @book.paper),
                ("電子書籍" if @book.ebook)
                ].compact.join("/") %>
            </td>
        </tr>
        
        <tr>
            <th>読書期間</th>
            <td>
                <p class="started_day">開始日：<%= @book.started_on %></p>
                <p>終了日：<%= @book.finished_on %></p>
            </td>
        </tr>

        <tr>
            <th>メモ</th>
            <td id="memo_area"><%= @book.memo %></td>
        </tr>
    </table>

    <div class="button_box">
        <%= link_to "編集", edit_book_path(@book), class:"button" %>
        <%= link_to "一覧に戻る", books_path, class:"button" %>
        <%= link_to "削除", @book, class:"button", data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？"} %>
    </div>
</div>
