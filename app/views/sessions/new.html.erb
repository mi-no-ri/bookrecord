<div class="wrap">
<h1>わたしの本棚</h1>

    <%= form_with url: login_path do |form| %>

    <% if @error.present? %>
    <p class="error_message">
        <%= @error %>
    </p>
    <% end %>

    <div id="sessions_new_container">
        <table id="sessions_new_table">
            <tr>
                <th><%= form.label :email, "メールアドレス" %></th>
                <td><%= form.email_field :email %></td>
            </tr>
            <tr>
                <th><%= form.label :password, "パスワード" %></th>
                <td><%= form.password_field :password %></td>
            </tr>
        </table>

        <div id="login_button_box">
            <%= form.submit "ログイン", class:"button login_button" %>
        </div>
    </div>
    
    <div class="link_box">
        <%= link_to "新規登録はこちら", new_user_path, id:"new_user_link" %>
        <%= link_to "ゲストログイン", guest_login_path, method: :post, id:"guest_login_link" %>
    </div>

    <% end %>
</div>